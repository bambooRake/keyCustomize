;; Kanata macOS config — migrated from Karabiner complex_modifications
;; 2026-05-10: LalaPadGen2 (ZMK) のキーマップ準拠に再構成
;;   元: /Users/mbamb/0_git/zmk-config-LalaPadGen2/config/lalapadgen2.keymap
;;   読み替え: ZMK の LGUI → kanata の lctl、LCTRL → kanata の lmet
;;             (Mac 慣習として A=⌘, W=⌃ を維持)
;;   wheel の数値 (75/2) は既存値を踏襲
;;   sticky_mod の 300ms 余韻は (one-shot 300 …) で再現 (2026-05-13)
;;
;; Prerequisites:
;;   1. Karabiner DriverKit VirtualHIDDevice がインストール済み
;;      (Karabiner-Elements をインストール済みなら OK)
;;   2. Apple 内蔵キーボードの修飾キー入替:
;;      System Settings > Keyboard > Keyboard Shortcuts > Modifier Keys で設定
;;   3. Parallels の Ctrl/Cmd 入替:
;;      Parallels > Preferences > Shortcuts で設定
;;      (Kanata にはアプリ別条件分岐がないため)
;;
;; Run:
;;   kanata --check -c ~/.config/kanata/config_macos.kbd
;;   kanata -c ~/.config/kanata/config_macos.kbd
;;
;; Tap-Hold 方式: tap-hold (timeout のみで判定 / ZMK "timeout" 方式)
;;   - timeout 内に離す → tap 発動 (文字出力) ※他キー押下は無視
;;   - timeout 経過まで押しっぱなし → hold 発動 (modifier / layer)
;;   ※ 誤発動が増えるなら tap-hold-release (ZMK "balanced" 相当) に戻す
;;     (他キーを押して離す→hold、先にこのキーを離す→tap)

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes   ;; defchordsv2 利用に必須

  ;; kanata は内蔵キーボードだけに適用する。
  ;;   - LalaPad は ZMK ファーム + Karabiner(変換/無変換→かな/英数) が担当するので kanata は触らない
  ;;     → LalaPad 内蔵マウス(&mkp/カーソル)を kanata が grab しなくなり、クリック競合が解消
  ;;   - 他キーボードを kanata 対象にしたくなったら、この include に名前を追記する
  ;;   - デバイス名は `sudo kanata-osx-fork --list` / ioreg の Product 名で確認
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
)

;; ════════════════════════════════════════════
;; Virtual keys — LalaPad 風 sticky modifier 用
;; ════════════════════════════════════════════
;; vk-<mod>  : 修飾キーそのもの (press-vkey すると修飾キー押下、release-vkey すると解放)
;; dr-<mod>  : "delayed release" 用 macro vkey — タップすると 300ms 待って vk-<mod> を解放
(defvirtualkeys
  vk-lctl lctl
  vk-lmet lmet
  vk-lalt lalt
  vk-lsft lsft
  vk-ralt ralt
  dr-lctl (macro 300 (on-press release-vkey vk-lctl))
  dr-lmet (macro 300 (on-press release-vkey vk-lmet))
  dr-lalt (macro 300 (on-press release-vkey vk-lalt))
  dr-lsft (macro 300 (on-press release-vkey vk-lsft))
  dr-ralt (macro 300 (on-press release-vkey vk-ralt))
)

(defalias
  ;; ════════════════════════════════════════════
  ;; sticky modifier helpers (LalaPad 風 300ms 余韻)
  ;; ════════════════════════════════════════════
  ;; tap-hold の hold アクションに渡すと:
  ;;   - hold engage 時: press-vkey で vk-<mod> を押下 (= 修飾キー押下)
  ;;   - host key release 時: dr-<mod> をタップ → 300ms 待って vk-<mod> を解放
  ;; press-vkey は明示的 release があるまで保持されるため、tap-hold lifecycle と切り離せる。
  sm-lctl (multi (on-press press-vkey vk-lctl) (on-release tap-vkey dr-lctl))
  sm-lmet (multi (on-press press-vkey vk-lmet) (on-release tap-vkey dr-lmet))
  sm-lalt (multi (on-press press-vkey vk-lalt) (on-release tap-vkey dr-lalt))
  sm-lsft (multi (on-press press-vkey vk-lsft) (on-release tap-vkey dr-lsft))
  sm-ralt (multi (on-press press-vkey vk-ralt) (on-release tap-vkey dr-ralt))

  ;; ════════════════════════════════════════════
  ;; Layer triggers
  ;; ════════════════════════════════════════════
  ;; Lang2: tap=英数, hold=Layer-2
  ;; Lang1:  tap=かな, hold=Layer-3
  ;; space: tap=Space / 1tap-hold=L1 / 2tap-hold=Space押しっぱ
  spc1 (tap-dance 220 (
    (tap-hold-press 0 200 spc (layer-while-held L1))
    spc
  ))
  ;; eis2: tap=英数 / 1tap-hold=L2 / 2tap-hold=L1 / 3tap-hold=L3
  eis2 (tap-dance 220 (
    (tap-hold-press 0 200 Lang2 (layer-while-held L2))
    (layer-while-held L1)
    (layer-while-held L3)
  ))
  kan3 (tap-hold-press 0 200 Lang1 (layer-while-held L3))

  ;; ════════════════════════════════════════════
  ;; Layer-0 (Default) — home-row mods
  ;; ════════════════════════════════════════════
  ;; macOS modifiers: lctl=Control, lmet=Command(⌘), lalt=Option(⌥), lsft=Shift
  q0 (tap-hold 0 200 q (macro esc))   ;; 長押しでも esc は 1 回タップで固定
  w0 (tap-hold 0 200 w @sm-lctl)   ;; LalaPad: hold=lctl + 300ms 余韻
  r0 (tap-hold 0 200 r (macro Lang1))  ;; hold=かな (1回タップ)
  a0 (tap-hold 0 200 a @sm-lmet)   ;; LalaPad: hold=lmet + 300ms 余韻
  s0 (tap-hold 0 200 s @sm-lalt)   ;; LalaPad: hold=lalt + 300ms 余韻
  d0 (tap-hold 0 200 d (layer-while-held L2))         ;; LalaPad: lt 2 D
  f0 (tap-hold 0 200 f (macro Lang2))                 ;; hold=英数 (1回タップ)
  z0 (tap-hold 0 200 z @sm-lsft)   ;; LalaPad: hold=lsft + 300ms 余韻
  c0 (tap-hold 0 500 c (macro caps))   ;; 500ms — 誤爆防止 / 1回タップ

  ;; ════════════════════════════════════════════
  ;; Layer-1 (Numbers & Symbols) — home-row mods
  ;; ════════════════════════════════════════════
  ;; LalaPad SECONDARY_LAYER 準拠
  w1 (tap-hold 0 200 \  @sm-lctl)  ;; LalaPad: hold=lctl + 300ms 余韻
  a1 (tap-hold 0 200 1  @sm-lmet)  ;; LalaPad: hold=lmet + 300ms 余韻
  s1 (tap-hold 0 200 2  @sm-lalt)  ;; LalaPad: hold=lalt + 300ms 余韻
  d1 (tap-hold 0 200 3  (macro [))   ;; LalaPad: mt LEFT_BRACKET N3
  f1 (tap-hold 0 200 4  (macro ]))   ;; LalaPad: mt RIGHT_BRACKET N4
  g1 (tap-hold 0 200 5  (macro f5))
  z1 (tap-hold 0 200 6  @sm-lsft)  ;; LalaPad: hold=lsft + 300ms 余韻
  x1 (tap-hold 0 200 7  (macro ,))   ;; LalaPad: mt_tap COMMA N7
  c1 (tap-hold 0 200 8  (macro .))   ;; LalaPad: mt_tap DOT N8
  v1 (tap-hold 0 200 9  (macro ;))
  b1 (tap-hold 0 200 0  (macro \))

  ;; ════════════════════════════════════════════
  ;; Layer-2 (Mouse & Navigation) — home-row mods + tap-dance
  ;; ════════════════════════════════════════════
  q2 (tap-hold 0 200 esc  (macro f13))  ;; LalaPad: mt_tap PRINTSCREEN ESCAPE (PrtSc は F13 代替)
  w2 (tap-hold 0 200 .    @sm-lctl)   ;; LalaPad: hold=lctl + 300ms 余韻
  a2 (tap-hold 0 200 -    @sm-lmet)   ;; LalaPad: hold=lmet + 300ms 余韻
  s2 (tap-hold 0 200 ret  @sm-lalt)   ;; LalaPad: hold=lalt + 300ms 余韻
  z2 (tap-hold 0 200 ins  @sm-lsft)   ;; LalaPad: hold=lsft + 300ms 余韻
  y2 (tap-hold 0 200 home (macro end))
  l2 (tap-hold 0 200 ralt (macro ret))  ;; LalaPad: mt ENTER RIGHT_ALT (奇妙だが準拠)
  ;; wheel tap-dance — distance/interval は既存値 (75 / 2) を踏襲
  se2 (tap-dance 220 ((mwheel-up   75 2) (mwheel-left  75 2)))  ;; LalaPad: tp_msc_up_left
  sd2 (tap-dance 220 ((mwheel-down 75 2) (mwheel-right 75 2)))  ;; LalaPad: tp_msc_down_right
  mr2 (tap-dance 220 (mbck mfwd))                               ;; LalaPad: tp_mkp_mb4_mb5

  ;; ════════════════════════════════════════════
  ;; Layer-3 (System: 左手) — home-row mods
  ;; ════════════════════════════════════════════
  ;; LalaPad SYSTEM_LAYER の左手側準拠 (BT/reset 等は kanata で代替不可なので外し、
  ;; Mac で動く音量/明度のみ採用)。右手側は既存 kanata の L3 を維持 (deflayermap 参照)。
  w3 (tap-hold 0 200 brup (macro brdn)) ;; LalaPad: mt_tap BRT_DEC BRT_INC
  a3 (tap-hold 0 200 volu @sm-lmet) ;; LalaPad: hold=lmet + 300ms 余韻
  s3 (tap-hold 0 200 ret  @sm-lalt) ;; LalaPad: hold=lalt + 300ms 余韻
  z3 (tap-hold 0 200 vold @sm-lsft) ;; LalaPad: hold=lsft + 300ms 余韻
  t3 (tap-hold 0 200 home (macro end))
  l3 (tap-hold 0 200 spc  @sm-ralt) ;; LalaPad: hold=ralt + 300ms 余韻

  ;; ════════════════════════════════════════════
  ;; Note: 修飾系 home-row mods は tap-hold + one-shot で実装
  ;; ════════════════════════════════════════════
  ;; tap = 文字 / hold = 修飾キー (+ リリース後 300ms 余韻)
  ;;   → ホールド離した直後に次のキーを叩けば修飾が乗る (LalaPad sticky_mod 相当)
  ;;   → 300ms 内に別キーが押されなければ静かに修飾解除
  ;; ※ 旧 tap-dance 方式 (2tap=修飾+同キー) は撤去
  ;;   → tap-dance timeout (220ms) 分の入力遅延も解消

  ;; ════════════════════════════════════════════
  ;; Combos (LalaPad → kanata 試験移植)
  ;; ════════════════════════════════════════════
  ;; eisuu(Lang2) + t 同時押し → "L2 + LEFT_ALT"
  ;; (LalaPad の COMBO_TAB_ALT 相当を Mac の英数キー側で再現)
  et_co (multi (layer-while-held L2) lalt)
)

(defsrc)

;; ════════════════════════════════════════════
;; Combos (defchordsv2 / 試験移植)
;; ════════════════════════════════════════════
;; LalaPad の COMBO_TAB_ALT を移植。Mac では英数(Lang2) / 無変換(muhenkan) / 変換(henkan) + t の同時押しで発火。
;; defchordsv2 は全レイヤー横断で評価され、かつ tap-hold の遅延フローを通らない
;; (chord-action 直行) ため副作用が出やすい。
;; 不調なら下記ブロックごと削除すること。base 以外では無効化済み。
(defchordsv2
  (Lang2    t) @et_co 100 all-released (L1 L2 L3)
  (muhenkan t) @et_co 100 all-released (L1 L2 L3)
  (henkan   t) @et_co 100 all-released (L1 L2 L3)
)

;; ── Base layer (Layer-0) ──
(deflayermap (base)
  q     @q0
  w     @w0
  r     @r0
  a     @a0
  s     @s0
  d     @d0          ;; LalaPad: lt 2 D — tap=d, hold=L2
  f     @f0
  z     @z0
  c     @c0
  spc      @spc1
  Lang2    @eis2
  muhenkan @eis2   ;; F長押し(無変換=INT5) → 英数(Lang2)
  henkan   @kan3   ;; R長押し(変換=INT4)   → かな(Lang1)  ※以前は @eis2 で英数に潰れていた
  Lang1    @kan3
  ;; Apple 内蔵キーボードの Fn(globe) を L2 modifier として使う。
  ;; macOS の Fn-row → media-key 変換は kanata が内蔵 KB を grab した時点で失われるため、
  ;; kanata 側で Fn+F1..F12 → consumer key (page 0x0C) を直接 emit して復元する。
  ;; 参照: GitHub jtroo/kanata issue #975 / #1141 / discussion #686
  fn    (layer-while-held L2)
  ;; JIS「ろ」(international1): ANSI 認識だと無反応なので US の `/~ に割当
  ro    grv
)

;; ── Layer-1: Numbers & Symbols (LalaPad SECONDARY_LAYER 準拠) ──
(deflayermap (L1)
  q /
  w @w1
  e -
  r '
  t =
  y f1    u f2    i f3    o f4    p f5
  a @a1
  s @s1
  d @d1
  f @f1
  g @g1
  h f6    j f7    k f8    l f9    ; f10
  z @z1
  x @x1
  c @c1
  v @v1
  b @b1
  n f11   m f12
  , [     . ]     / \
)

;; ── Layer-2: Mouse & Navigation (LalaPad TERTIARY_LAYER 準拠) ──
(deflayermap (L2)
  ;; 左手上段
  q @q2                     ;; tap=Esc, hold=F13 (PrtSc 代替)
  w @w2                     ;; tap=., hold=lctl
  e @se2                    ;; tap-dance: scroll-up / dbl-tap=scroll-left
  r @mr2                    ;; tap-dance: mb4 / dbl-tap=mb5
  t tab                     ;; LalaPad: kp TAB
  ;; 右手上段
  y @y2                     ;; tap=Home, hold=End
  u up
  i tab
  o rmet                    ;; LalaPad: kp RWIN
  p esc
  ;; 左手中段
  a @a2                     ;; tap=-, hold=lmet
  s @s2                     ;; tap=Return, hold=lalt
  d @sd2                    ;; tap-dance: scroll-down / dbl-tap=scroll-right
  f mlft                    ;; LalaPad: mkp MB1
  g mmid                    ;; LalaPad: mkp MB3
  ;; 右手中段 (Vim-style nav)
  h left
  j down
  k rght
  l @l2                     ;; tap=RightOption, hold=Return
  ; rctl                    ;; LalaPad: kp RIGHT_CONTROL
  ;; 左手下段
  z @z2                     ;; tap=Insert, hold=lsft
  x bspc                    ;; LalaPad: kp BACKSPACE
  c spc                     ;; LalaPad: kp SPACE
  v mrgt                    ;; LalaPad: mkp MB2
  b del
  ;; 右手下段
  n bspc                    ;; LalaPad: kp BACKSPACE
  m pgdn
  , pgup
  . del
  / rsft
  ;; その他
  Lang2    spc              ;; L2 では 英数(Lang2)      → Space に変換
  muhenkan spc              ;; L2 では 無変換(muhenkan) → Space に変換
  henkan   spc              ;; L2 では 変換(henkan)     → Space に変換
  ;; Fn(globe) hold + F-row → media keys (consumer page 0x0C を直接 emit)
  ;; macOS 標準の "Use F1, F2... as standard function keys" ON 時相当の挙動を kanata で再現
  f1  brdn                  ;; Fn+F1  → Brightness Down
  f2  brup                  ;; Fn+F2  → Brightness Up
  f3  mctl                  ;; Fn+F3  → Mission Control (consumer 0x0C/0x29F)
  f4  sls                   ;; Fn+F4  → Spotlight Search (consumer 0x0C/0x221)
                            ;;          旧 MacBook 風の Launchpad にするなら lpad に変更
  f5  dtn                   ;; Fn+F5  → Dictation 🎤      (consumer 0x0C/0xCF)
  f6  dnd                   ;; Fn+F6  → Do Not Disturb 🌙 (generic-desktop 0x01/0x9B)
  f7  prev                  ;; Fn+F7  → Media Previous
  f8  pp                    ;; Fn+F8  → Media Play/Pause
  f9  next                  ;; Fn+F9  → Media Next
  f10 mute                  ;; Fn+F10 → Mute
  f11 vold                  ;; Fn+F11 → Volume Down
  f12 volu                  ;; Fn+F12 → Volume Up
)

;; ── Layer-3: System (左手=LalaPad SYSTEM 準拠) ──
(deflayermap (L3)
  ;; 左手 — LalaPad SYSTEM_LAYER 準拠 (Mac で動かない BT/reset/zoom 系は外す)
  q mute                    ;; LalaPad: kp C_MUTE
  w @w3                     ;; tap=brup, hold=brdn
  e XX                      ;; LalaPad: K_CONTEXT_MENU — Mac 代替なしのため無効化
  r up                      ;; LalaPad: kp UP_ARROW
  t @t3                     ;; tap=Home, hold=End
  a @a3                     ;; tap=VolUp, hold=lmet
  s @s3                     ;; tap=Return, hold=lalt
  d left                    ;; LalaPad: kp LEFT_ARROW
  f down                    ;; LalaPad: kp DOWN_ARROW
  g rght                    ;; LalaPad: kp RIGHT_ARROW
  z @z3                     ;; tap=VolDown, hold=lsft
  x bspc                    ;; LalaPad: kp BACKSPACE
  c pgup                    ;; LalaPad: kp PAGE_UP (注: 元の System layer は元々 trans)
  v pgdn
  b del
)
