;; Kanata macOS config — migrated from Karabiner complex_modifications
;; 2026-05-10: LalaPadGen2 (ZMK) のキーマップ準拠に再構成
;;   元: /Users/mbamb/0_git/zmk-config-LalaPadGen2/config/lalapadgen2.keymap
;;   読み替え: ZMK の LGUI → kanata の lctl、LCTRL → kanata の lmet
;;             (Mac 慣習として A=⌘, W=⌃ を維持)
;;   wheel の数値 (75/2) は既存値を踏襲
;;   sticky_mod の 400ms 余韻は kanata で正確再現困難のため省略
;;
;; Prerequisites:
;;   1. Karabiner DriverKit VirtualHIDDevice がインストール済み
;;      (Karabiner-Elements をインストール済みなら OK)
;;   2. Apple 内蔵キーボードの修飾キー入替:
;;      System Settings > Keyboard > Keyboard Shortcuts > Modifier Keys で設定
;;   3. Parallels の Ctrl/Cmd 入替:
;;      Parallels > Preferences > Shortcuts で設定
;;      (Kanata にはアプリ別条件分岐がないため)
;;
;; Run:
;;   kanata --check -c ~/.config/kanata/config_macos.kbd
;;   kanata -c ~/.config/kanata/config_macos.kbd
;;
;; Tap-Hold 方式: tap-hold-release (ZMK "balanced" 相当)
;;   - 他キーを押して離す → hold 発動 (modifier+key)
;;   - 先にこのキーを離す → tap 発動 (文字出力)
;;   - timeout まで何もしない → hold 発動 (modifier 単独)
;;   ※ もし高速タイプで誤発動する場合は tap-hold (timeout のみ) に変更

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes   ;; defchordsv2 利用に必須
)

(defalias
  ;; ════════════════════════════════════════════
  ;; Layer triggers
  ;; ════════════════════════════════════════════
  ;; Lang2: tap=英数, hold=Layer-2
  ;; Lang1:  tap=かな, hold=Layer-3
  ;; space: tap=Space, hold=Layer-1
  spc1 (tap-hold-press 200 250 spc (layer-while-held L1))
  eis2 (tap-hold-press 0 200 Lang2 (layer-while-held L2))
  kan3 (tap-hold-press 0 200 Lang1  (layer-while-held L3))

  ;; ════════════════════════════════════════════
  ;; Layer-0 (Default) — home-row mods
  ;; ════════════════════════════════════════════
  ;; macOS modifiers: lctl=Control, lmet=Command(⌘), lalt=Option(⌥), lsft=Shift
  q0 (tap-hold-release 200 250 q (macro esc))   ;; 長押しでも esc は 1 回タップで固定
  w0 (tap-hold-release 200 250 w lctl)   ;; LalaPad: mt LGUI W → lctl
  r0 (tap-hold-release 200 250 r (macro Lang1))  ;; hold=かな (1回タップ)
  a0 (tap-hold-release 200 250 a lmet)           ;; LalaPad: mt LCTRL A → lmet
  s0 (tap-hold-release 200 250 s lalt)
  d0 (tap-hold-release 200 250 d (layer-while-held L2))  ;; LalaPad: lt 2 D
  f0 (tap-hold-release 200 250 f (macro Lang2))  ;; hold=英数 (1回タップ)
  z0 (tap-hold-release 200 250 z lsft)
  c0 (tap-hold-release 200 500 c (macro caps))   ;; 500ms — 誤爆防止 / 1回タップ

  ;; ════════════════════════════════════════════
  ;; Layer-1 (Numbers & Symbols) — home-row mods
  ;; ════════════════════════════════════════════
  ;; LalaPad SECONDARY_LAYER 準拠
  w1 (tap-hold-release 200 250 \  lctl)   ;; LalaPad: mt LWIN BACKSLASH → lctl
  a1 (tap-hold-release 200 250 1  lmet)   ;; LalaPad: mt LCTRL N1 → lmet
  s1 (tap-hold-release 200 250 2  lalt)
  d1 (tap-hold-release 200 250 3  (macro [))   ;; LalaPad: mt LEFT_BRACKET N3
  f1 (tap-hold-release 200 250 4  (macro ]))   ;; LalaPad: mt RIGHT_BRACKET N4
  g1 (tap-hold-release 200 250 5  (macro f5))
  z1 (tap-hold-release 200 250 6  lsft)
  x1 (tap-hold-release 200 250 7  (macro ,))   ;; LalaPad: mt_tap COMMA N7
  c1 (tap-hold-release 200 250 8  (macro .))   ;; LalaPad: mt_tap DOT N8
  v1 (tap-hold-release 200 250 9  (macro ;))
  b1 (tap-hold-release 200 250 0  (macro \))

  ;; ════════════════════════════════════════════
  ;; Layer-2 (Mouse & Navigation) — home-row mods + tap-dance
  ;; ════════════════════════════════════════════
  q2 (tap-hold-release 200 250 esc  (macro f13))  ;; LalaPad: mt_tap PRINTSCREEN ESCAPE (PrtSc は F13 代替)
  w2 (tap-hold-release 200 250 .    lctl)         ;; LalaPad: mt LWIN PERIOD → lctl
  a2 (tap-hold-release 200 250 -    lmet)         ;; LalaPad: mt LCTRL MINUS → lmet
  s2 (tap-hold-release 200 250 ret  lalt)
  z2 (tap-hold-release 200 250 ins  lsft)
  y2 (tap-hold-release 200 250 home (macro end))
  l2 (tap-hold-release 200 250 ralt (macro ret))  ;; LalaPad: mt ENTER RIGHT_ALT (奇妙だが準拠)
  ;; wheel tap-dance — distance/interval は既存値 (75 / 2) を踏襲
  se2 (tap-dance 300 ((mwheel-up   75 2) (mwheel-left  75 2)))  ;; LalaPad: tp_msc_up_left
  sd2 (tap-dance 300 ((mwheel-down 75 2) (mwheel-right 75 2)))  ;; LalaPad: tp_msc_down_right
  mr2 (tap-dance 300 (mbck mfwd))                               ;; LalaPad: tp_mkp_mb4_mb5

  ;; ════════════════════════════════════════════
  ;; Layer-3 (System: 左手) — home-row mods
  ;; ════════════════════════════════════════════
  ;; LalaPad SYSTEM_LAYER の左手側準拠 (BT/reset 等は kanata で代替不可なので外し、
  ;; Mac で動く音量/明度のみ採用)。右手側は既存 kanata の L3 を維持 (deflayermap 参照)。
  w3 (tap-hold-release 200 250 brup (macro brdn)) ;; LalaPad: mt_tap BRT_DEC BRT_INC
  a3 (tap-hold-release 200 250 volu lmet)         ;; LalaPad: mt LCTRL C_VOLUME_UP → lmet
  s3 (tap-hold-release 200 250 ret  lalt)         ;; LalaPad: mt LALT ENTER
  z3 (tap-hold-release 200 250 vold lsft)         ;; LalaPad: mt LSHIFT C_VOLUME_DOWN
  t3 (tap-hold-release 200 250 home (macro end))
  l3 (tap-hold-release 200 250 spc  ralt)

  ;; ════════════════════════════════════════════
  ;; Tap-dance 版 (opt-in)
  ;; ════════════════════════════════════════════
  ;; 安定動作確認後、上の tap-hold-release を以下に差し替え可能
  ;; 1tap = tap-hold, 2tap = modifier+key (例: 2tap z = Shift+Z)
  ;; ※ tap-dance timeout 分 (120ms) の入力遅延が全キーに発生する
  ;;
  ;; w0-td (tap-dance 120 ((tap-hold-release 200 250 w lctl) C-w))
  ;; a0-td (tap-dance 120 ((tap-hold-release 200 250 a lmet) M-a))
  ;; s0-td (tap-dance 120 ((tap-hold-release 200 250 s lalt) A-s))
  ;; z0-td (tap-dance 120 ((tap-hold-release 200 250 z lsft) S-z))

  ;; ════════════════════════════════════════════
  ;; Combos (LalaPad → kanata 試験移植)
  ;; ════════════════════════════════════════════
  ;; eisuu(Lang2) + t 同時押し → "L2 + LEFT_ALT"
  ;; (LalaPad の COMBO_TAB_ALT 相当を Mac の英数キー側で再現)
  et_co (multi (layer-while-held L2) lalt)
)

(defsrc)

;; ════════════════════════════════════════════
;; Combos (defchordsv2 / 試験移植)
;; ════════════════════════════════════════════
;; LalaPad の COMBO_TAB_ALT を移植。Mac では英数(Lang2) + t の同時押しで発火。
;; defchordsv2 は全レイヤー横断で評価され、かつ tap-hold の遅延フローを通らない
;; (chord-action 直行) ため副作用が出やすい。
;; 不調なら下記ブロックごと削除すること。base 以外では無効化済み。
(defchordsv2
  (Lang2 t) @et_co 100 all-released (L1 L2 L3)
)

;; ── Base layer (Layer-0) ──
(deflayermap (base)
  q     @q0
  w     @w0
  r     @r0
  a     @a0
  s     @s0
  d     @d0          ;; LalaPad: lt 2 D — tap=d, hold=L2
  f     @f0
  z     @z0
  c     @c0
  spc   @spc1
  Lang2 @eis2
  Lang1 @kan3
)

;; ── Layer-1: Numbers & Symbols (LalaPad SECONDARY_LAYER 準拠) ──
(deflayermap (L1)
  q /
  w @w1
  e -
  r '
  t =
  y f1    u f2    i f3    o f4    p f5
  a @a1
  s @s1
  d @d1
  f @f1
  g @g1
  h f6    j f7    k f8    l f9    ; f10
  z @z1
  x @x1
  c @c1
  v @v1
  b @b1
  n f11   m f12
  , [     . ]     / \
)

;; ── Layer-2: Mouse & Navigation (LalaPad TERTIARY_LAYER 準拠) ──
(deflayermap (L2)
  ;; 左手上段
  q @q2                     ;; tap=Esc, hold=F13 (PrtSc 代替)
  w @w2                     ;; tap=., hold=lctl
  e @se2                    ;; tap-dance: scroll-up / dbl-tap=scroll-left
  r @mr2                    ;; tap-dance: mb4 / dbl-tap=mb5
  t tab                     ;; LalaPad: kp TAB
  ;; 右手上段
  y @y2                     ;; tap=Home, hold=End
  u up
  i tab
  o rmet                    ;; LalaPad: kp RWIN
  p esc
  ;; 左手中段
  a @a2                     ;; tap=-, hold=lmet
  s @s2                     ;; tap=Return, hold=lalt
  d @sd2                    ;; tap-dance: scroll-down / dbl-tap=scroll-right
  f mlft                    ;; LalaPad: mkp MB1
  g mmid                    ;; LalaPad: mkp MB3
  ;; 右手中段 (Vim-style nav)
  h left
  j down
  k rght
  l @l2                     ;; tap=RightOption, hold=Return
  ; rctl                    ;; LalaPad: kp RIGHT_CONTROL
  ;; 左手下段
  z @z2                     ;; tap=Insert, hold=lsft
  x bspc                    ;; LalaPad: kp BACKSPACE
  c spc                     ;; LalaPad: kp SPACE
  v mrgt                    ;; LalaPad: mkp MB2
  b del
  ;; 右手下段
  n bspc                    ;; LalaPad: kp BACKSPACE
  m pgdn
  , pgup
  . del
  / rsft
)

;; ── Layer-3: System (左手=LalaPad SYSTEM 準拠) ──
(deflayermap (L3)
  ;; 左手 — LalaPad SYSTEM_LAYER 準拠 (Mac で動かない BT/reset/zoom 系は外す)
  q mute                    ;; LalaPad: kp C_MUTE
  w @w3                     ;; tap=brup, hold=brdn
  e XX                      ;; LalaPad: K_CONTEXT_MENU — Mac 代替なしのため無効化
  r up                      ;; LalaPad: kp UP_ARROW
  t @t3                     ;; tap=Home, hold=End
  a @a3                     ;; tap=VolUp, hold=lmet
  s @s3                     ;; tap=Return, hold=lalt
  d left                    ;; LalaPad: kp LEFT_ARROW
  f down                    ;; LalaPad: kp DOWN_ARROW
  g rght                    ;; LalaPad: kp RIGHT_ARROW
  z @z3                     ;; tap=VolDown, hold=lsft
  x bspc                    ;; LalaPad: kp BACKSPACE
  c pgup                    ;; LalaPad: kp PAGE_UP (注: 元の System layer は元々 trans)
  v pgdn
  b del
)
