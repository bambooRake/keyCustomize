{
  "title": "Apple Inner Keyboard Swap Modifier Keys",
  "rules": [
    {
      "description": "Apple Inner Keyboard Swap Modifier Keys",
      "enabled": false,
      "manipulators": [
        {
          "conditions": [
            {
              "identifiers": [
                {
                  "is_built_in_keyboard": true,
                  "is_keyboard": true
                }
              ],
              "type": "device_if"
            }
          ],
          "from": {
            "key_code": "left_control"
          },
          "to": [
            {
              "key_code": "left_command"
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "identifiers": [
                {
                  "is_built_in_keyboard": true,
