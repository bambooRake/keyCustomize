      "enabled": true,
      "manipulators": [
        {"from": {"key_code": "left_control"}, "to": [{"key_code": "left_command"}], "type": "basic", "conditions": [{"identifiers": [{"is_built_in_keyboard": true, "is_keyboard": true}], "type": "device_if"}, {"type": "frontmost_application_unless", "bundle_identifiers": ["^com\\.parallels\\.desktop\\.console$"]}]},
